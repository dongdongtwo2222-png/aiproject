# 지도 생성
seoul_map = folium.Map(
    location=[37.5665, 126.9780],
    zoom_start=12,
    tiles="OpenStreetMap",
    control_scale=True
)

for place in PLACES:
    popup_html = f"""
    <div style="font-family:Arial,sans-serif;width:230px;">
        <h4 style="margin-bottom:5px;">TOP {place['rank']}. {place['name']}</h4>
        <div style="color:#666;margin-bottom:8px;">{place['english']}</div>
        <div style="font-size:13px;">{place['description']}</div>
    </div>
    """
    marker_icon = folium.DivIcon(
        html=f"""
        <div style="
            background:#e53935;
            color:white;
            border:2px solid white;
            border-radius:50%;
            width:30px;
            height:30px;
            line-height:26px;
            text-align:center;
            font-weight:bold;
            box-shadow:0 1px 5px #777;">
            {place['rank']}
        </div>
        """
    )
    folium.Marker(
        location=[place["lat"], place["lon"]],
        tooltip=f"TOP {place['rank']} · {place['name']}",
        popup=folium.Popup(popup_html, max_width=300),
        icon=marker_icon
    ).add_to(seoul_map)

st.subheader("📍 서울 관광지 TOP 10 지도")
